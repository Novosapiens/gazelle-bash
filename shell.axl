"""Gazelle (Aspect Orion) extension for Bash scripts and bats tests.

Started from aspect-starters/shell `.aspect/gazelle/shell.axl` (Apache-2.0), then extended:

  * one target per script, so Bazel can skip tests a change cannot reach, or with
    `bash_generation_mode package` one library and one filegroup per directory (tests
    still get one target each);
  * `source path` / `. path` lines, and bats `load name` lines, become `data`;
  * in a test, every `$VAR/path` whose VAR is listed in `bash_root_vars` becomes `data`;
  * in a test, a command run by bare name from a `bash_path_dirs` directory becomes `data`,
    and with `bash_subcommands`, `tool sync` depends on the dispatcher without its
    subcommands and on the one file that runs `sync`;
  * `# gazelle-bash: dep <path>` (also spelled `# gazelle:sh_dynamic_dep` and
    `# gazelle:bats_data`) and `# shellcheck source=<path>` declare a dependency that
    cannot be read statically.

Targets of deleted files are removed by `wrapper/prune_stale.sh`, which `gazelle_bash()` in
`defs.bzl` runs before Gazelle: Orion doesn't show this extension the existing BUILD file.

Generation rules:

  | Input                                  | Output                 |
  | -------------------------------------- | ---------------------- |
  | `*_test.sh`                            | `sh_test`              |
  | other `*.sh` / `*.bash`                | `sh_library`           |
  | no extension, sh/bash shebang line 1   | `sh_library`           |
  | `*.bats`                               | `bats_test`            |
  | file matching `bash_data_files`        | `filegroup`            |

A command is an `sh_library` too, not an `sh_binary`. `bats_test` gives a test the files of
its `data` targets but not their runfiles, and only `sh_library` passes on the files of what
it depends on. An `sh_binary` in the chain would drop the libraries a command sources.

Every dependency goes in `data`: it accepts scripts and plain files alike, and it is the
only dependency attribute `bats_test` has.

Every script publishes its workspace-relative path as a `shell` symbol, so a captured
path resolves to the label of whichever target owns that script, in any package.
A literal path that matches no script fails generation. A path that starts with a `bash_root_vars`
variable resolves from that variable's directory. A path still containing `$`
after normalisation is reported and skipped; declare it with a comment instead.
`source name` with no slash is skipped when no such file sits next to the script, since
Bash would find it on PATH. Heredoc bodies and multi-line strings are not read, and
`# gazelle-bash: ignore` makes the plugin skip one line.
"""

_PROVIDER = "shell"

# Every dependable file also publishes each directory above it under this provider, so
# "everything under dir/" is one import with `multiple = True`.
_TREE = "shell_tree"

# A file that runs a dispatcher's subcommand publishes `<dispatcher path> <name>` under this
# provider (`bin/tool sync`), and a dispatcher publishes its own path under `_DISPATCHER` on a
# target without its subcommands. A test that runs `tool sync` imports both. Each import falls
# back to the whole dispatcher through a symbol the test's package adds, so a word no file
# declares still gets a working dependency. See `_subcommand_imports`.
_SUBCOMMAND = "shell_subcommand"
_DISPATCHER = "shell_dispatcher"

# How many words after a dispatcher are tried as its subcommand, longest first.
_MAX_SUBCOMMAND_WORDS = 4

aspect.gazelle_rule_kind("sh_library", {
    "From": "@rules_shell//shell:sh_library.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["data"],
})
aspect.gazelle_rule_kind("sh_test", {
    "From": "@rules_shell//shell:sh_test.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["data"],
})
aspect.gazelle_rule_kind("bats_test", {
    "From": "@bazel_lib//lib:bats.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["data"],
})

# Native rule, registered so the symbols of generated filegroups are indexed.
aspect.gazelle_rule_kind("filegroup", {
    "MergeableAttrs": ["srcs"],
})

# --- Shell words -------------------------------------------------------------

def _word(s):
    """Reads the first shell word of `s`. Returns (word with quoting removed, chars consumed).

    Quotes nested inside `$(...)` / `${...}` are dropped too, so
    `"$(dirname "${BASH_SOURCE[0]}")/lib.sh"` becomes `$(dirname ${BASH_SOURCE[0]})/lib.sh`.
    """
    out = []
    quote = ""  # "", "'" or "\""
    depth = 0  # nesting of $( ) and ${ }
    escaped = False
    prev = ""
    end = len(s)
    for i in range(len(s)):
        c = s[i]
        if escaped:
            out.append(c)
            escaped = False
            prev = c
            continue
        if quote == "'":
            if c == "'":
                quote = ""
            else:
                out.append(c)
            prev = c
            continue
        if c == "\\":
            escaped = True
            prev = c
            continue
        if c == "'" or c == "\"":
            if depth == 0:
                if quote == "":
                    quote = c
                elif quote == c:
                    quote = ""
            prev = c
            continue
        if depth == 0 and quote == "":
            if c in " \t;&|<>)":
                end = i
                break
            if c == "#" and not out:
                end = i
                break
        if (c == "(" or c == "{") and (prev == "$" or depth > 0):
            depth += 1
        elif (c == ")" or c == "}") and depth > 0:
            depth -= 1
        out.append(c)
        prev = c
    return "".join(out), end

def _first_word(s):
    return _word(s)[0]

# --- Line scanner ------------------------------------------------------------

def _heredoc_starts(line):
    """Returns [(delimiter, strip_tabs)] for each heredoc opened on `line`.

    Skips here-strings (`<<<`), shifts inside `(( ))`, single-quoted text and comments.
    `<<` inside double quotes still counts, so `"$(cat <<EOF` is seen.
    """
    found = []
    quote = ""
    arith = 0
    skip_to = 0
    n = len(line)
    for i in range(n):
        if i < skip_to:
            continue
        c = line[i]
        if quote == "'":
            if c == "'":
                quote = ""
            continue
        if c == "\\":
            skip_to = i + 2
            continue
        if c == "'" and quote == "":
            quote = "'"
            continue
        if c == "\"":
            quote = "" if quote == "\"" else "\""
            continue
        if c == "#" and quote == "" and (i == 0 or line[i - 1] in " \t;"):
            break
        two = line[i:i + 2]
        if two == "((":
            arith += 1
            skip_to = i + 2
            continue
        if two == "))" and arith > 0:
            arith -= 1
            skip_to = i + 2
            continue
        if line[i:i + 3] == "<<<":
            skip_to = i + 3
            continue
        if two == "<<" and arith == 0:
            j = i + 2
            strip = False
            if j < n and line[j] == "-":
                strip = True
                j += 1
            rest = line[j:]
            j += len(rest) - len(rest.lstrip(" \t"))
            delim, used = _word(line[j:])
            if delim:
                found.append((delim, strip))
            skip_to = j + max(used, 1)
    return found

def _quote_after(line, quote):
    """Returns the quote state at the end of `line`, given the state at its start.

    The state is "" (not in a string), "'", "\"" or "$'". Comments are not read.
    """
    if quote == "" and "'" not in line and "\"" not in line:
        return ""
    skip_to = 0
    for i in range(len(line)):
        if i < skip_to:
            continue
        c = line[i]
        if quote == "'":
            if c == "'":
                quote = ""
        elif quote == "$'" or quote == "\"":
            if c == "\\":
                skip_to = i + 2
            elif c == quote[-1]:
                quote = ""
        elif c == "\\":
            skip_to = i + 2
        elif c == "'":
            quote = "$'" if i > 0 and line[i - 1] == "$" else "'"
        elif c == "\"":
            quote = "\""
        elif c == "#" and (i == 0 or line[i - 1] in " \t;(&|"):
            break
    return quote

def _directive(text, prefix):
    """If `text` starts with the word `prefix`, returns the rest, stripped. Otherwise None."""
    if text == prefix:
        return ""
    if text.startswith(prefix + " ") or text.startswith(prefix + "\t"):
        return text[len(prefix):].strip()
    return None

def _scan(content):
    """Returns [(kind, raw_arg, line_index)] for each dependency line in `content`.

    kind is one of "source", "load", "dep" (the gazelle-bash comment) or "shellcheck".
    For "shellcheck", raw_arg is the path with quoting already removed.

    Not read: heredoc bodies, lines that start inside a multi-line quoted string, and a
    line marked `# gazelle-bash: ignore` (on the line above, or at its end).

    Both trackers fall back to reading everything if they lose track: a heredoc that never
    closes is treated as a false match, and so is a string still open at the end of the file.
    """
    lines = content.split("\n")
    skip = {}
    pending = []  # open heredocs: [(delimiter, strip_tabs)]
    body = []  # line indexes of the heredoc bodies in `pending`
    quote = ""  # quote state at the start of the current line
    quoted = {}  # line indexes that start inside a quoted string
    for i in range(len(lines)):
        line = lines[i].removesuffix("\r")
        if pending:
            body.append(i)
            delim, strip = pending[0]
            if (line.lstrip("\t") if strip else line) == delim:
                pending.pop(0)
                if not pending:
                    for b in body:
                        skip[b] = True
                    body = []
            continue
        if quote:
            quoted[i] = True
        if quote != "'" and quote != "$'":
            pending.extend(_heredoc_starts(line))
        quote = _quote_after(line, quote)
    if quote:
        quoted = {}

    found = []
    ignored = {}  # line indexes marked `# gazelle-bash: ignore`
    for i in range(len(lines)):
        if i in skip or i in quoted:
            continue
        s = lines[i].strip()
        if s.startswith("#"):
            text = s.lstrip("#").strip()
            gb = _directive(text, "gazelle-bash:")
            if gb != None:
                if gb == "ignore":
                    ignored[i + 1] = True
                arg = _directive(gb, "dep")
                if arg:
                    found.append(("dep", arg, i))
                continue
            for name in ("gazelle:sh_dynamic_dep", "gazelle:bats_data"):
                arg = _directive(text, name)
                if arg:
                    found.append(("dep", arg, i))
            if text.startswith("gazelle:"):
                continue
            sc = _directive(text, "shellcheck")
            if sc != None:
                at = sc.find("source=")
                if at == 0 or (at > 0 and sc[at - 1] in " \t"):
                    word = _word(sc[at + len("source="):])[0]
                    if word:
                        found.append(("shellcheck", word, i))
            continue
        if i in ignored or s.endswith("# gazelle-bash: ignore"):
            continue
        for keyword, kind in (("source", "source"), (".", "source"), ("load", "load")):
            arg = _directive(s, keyword)
            if arg:
                found.append((kind, arg, i))
                break
    return found

# --- Paths -------------------------------------------------------------------

def _dir_prefixes(dir_vars):
    """Spellings of "the directory of this script", after quote removal."""
    prefixes = [
        "$(dirname ${BASH_SOURCE[0]})/",
        "$(dirname ${BASH_SOURCE})/",
        "$(dirname $BASH_SOURCE)/",
        "$(dirname -- ${BASH_SOURCE[0]})/",
        "$(dirname -- $0)/",
        "${BASH_SOURCE%/*}/",
        "${BASH_SOURCE[0]%/*}/",
        "$(dirname $0)/",
        "$(dirname ${0})/",
        "${0%/*}/",
        "$BATS_TEST_DIRNAME/",
        "${BATS_TEST_DIRNAME}/",
    ]
    for v in _list(dir_vars):
        prefixes.append("$" + v + "/")
        prefixes.append("${" + v + "}/")
    return prefixes

def _clean(p):
    """Collapses `.` and `..` segments. Returns None if the path escapes the workspace."""
    parts = []
    for seg in p.split("/"):
        if seg == "" or seg == ".":
            continue
        if seg == "..":
            if not parts:
                return None
            parts.pop()
        else:
            parts.append(seg)
    return "/".join(parts)

def _list(values):
    """Splits a list property on commas and whitespace: Orion passes `A,B` through as one value."""
    out = []
    for value in values:
        for item in value.replace(",", " ").split(" "):
            if item:
                out.append(item)
    return out

def _root_vars(entries):
    """Parses `NAME=path` entries into {NAME: workspace-relative path}. `.` is the workspace root."""
    roots = {}
    for entry in _list(entries):
        name, sep, value = entry.partition("=")
        name = name.strip()
        root = _clean(value.strip())
        if not sep or not name or root == None:
            fail("gazelle-bash: bash_root_vars entry must be NAME=path inside the workspace, got: " + entry)
        roots[name] = root
    return roots

def _unwrap_cd_pwd(word):
    """Rewrites `$(cd DIR && pwd)/rest` to `DIR/rest`. Redirections after DIR are dropped."""
    if not word.startswith("$(cd "):
        return word
    end = word.find(" && pwd)/")
    if end < 0:
        return word
    inner = word[len("$(cd "):end].removeprefix("-- ")
    for redirect in (" >", " &>", " 2>"):
        inner = inner.split(redirect)[0]
    return inner + "/" + word[end + len(" && pwd)/"):]

def _resolve(word, base_dir, prefixes, roots, allow_tree = False):
    """Turns a captured path into (workspace-relative path, is_tree), or None if it cannot
    be read statically.

    A path that starts with a `bash_root_vars` variable is resolved from that variable's
    directory. Otherwise a leading "directory of this script" idiom is stripped and the
    rest is resolved from `base_dir`.

    With `allow_tree`, a path that ends in `/` or holds a wildcard names a directory tree:
    the directory before the first wildcard. The root of the workspace is `.`.
    """
    if not word:
        return None
    word = _unwrap_cd_pwd(word)
    tree = allow_tree and word.endswith("/")
    rooted = False
    for name, root in roots.items():
        for prefix in ("$" + name + "/", "${" + name + "}/"):
            if word.startswith(prefix):
                word = word[len(prefix):]
                base_dir = root
                rooted = True
                break
        if rooted:
            break
    if not rooted:
        for prefix in prefixes:
            if word.startswith(prefix):
                word = word[len(prefix):]
                break
    if "`" in word or word.startswith("/") or word.startswith("~"):
        return None
    if allow_tree:
        segments = word.split("/")
        for i in range(len(segments)):
            if "*" in segments[i] or "?" in segments[i] or "[" in segments[i]:
                word = "/".join(segments[:i])
                tree = True
                break
    if "$" in word or "*" in word or "?" in word:
        return None
    joined = _clean(path.join(base_dir, word) if base_dir and word else (base_dir or word))
    if joined == None:
        return None
    if tree:
        return (joined or ".", True)
    return (joined, False) if joined else None

_PATH_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./*?$-+@%{}[]~"

def _refs(content, roots):
    """Returns [(path, line_index)] for every `$VAR/path` in `content` whose VAR is a
    `bash_root_vars` name. Full-line comments are not read; heredocs and strings are."""
    found = []
    lines = content.split("\n")
    for i in range(len(lines)):
        line = lines[i]
        if line.strip().startswith("#"):
            continue
        for name in roots:
            for prefix in ("$" + name + "/", "${" + name + "}/"):
                start = 0
                for _ in range(len(line)):
                    at = line.find(prefix, start)
                    if at < 0:
                        break
                    start = at + len(prefix)
                    if at > 0 and line[at - 1] == "\\":
                        continue
                    end = start
                    for j in range(start, len(line)):
                        if line[j] not in _PATH_CHARS:
                            break
                        end = j + 1
                    found.append((line[at:end], i))
    return found

# --- Commands run by name ----------------------------------------------------

_NAME_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.+-"

# Words after which the next word is still in command position.
_COMMAND_PREFIXES = {w: True for w in [
    "run", "bats_pipe", "if", "then", "else", "elif", "do", "while", "until", "time",
    "exec", "command", "env", "nohup", "sudo",
]}

# Bash runs these itself, before looking on PATH, so a file of the same name is never used.
_BUILTINS = {w: True for w in [
    "fi", "for", "done", "case", "esac", "in", "function", "select", "[", "[[", "]]", "}",
    ".", ":", "alias", "bg", "bind", "break", "builtin", "caller", "cd", "compgen", "complete",
    "compopt", "continue", "declare", "dirs", "disown", "echo", "enable", "eval", "exit",
    "export", "false", "fc", "fg", "getopts", "hash", "help", "history", "jobs", "kill", "let",
    "local", "logout", "mapfile", "popd", "printf", "pushd", "pwd", "read", "readarray",
    "readonly", "return", "set", "shift", "shopt", "source", "suspend", "test", "times", "trap",
    "true", "type", "typeset", "ulimit", "umask", "unalias", "unset", "wait",
]}

def _is_assignment(word):
    """True for `NAME=value`, which may come before a command."""
    name, sep, _ = word.partition("=")
    return bool(sep) and bool(name) and all([c in _NAME_CHARS and c not in ".+-" for c in name.elems()])

def _commands(content):
    """Returns [(word, line_index, rest of the line after the word)] for each bare word in
    command position in `content`, in order. A word can appear more than once.

    Command position is the start of a line, or after `|`, `&`, `;`, `(`, `)`, a backtick, `!`,
    a `{` standing alone, an assignment, or one of `_COMMAND_PREFIXES` (and, after `run`,
    its options). Bash
    builtins and keywords are left out. Full-line comments are not read; heredocs and
    strings are.
    """
    found = []
    lines = content.split("\n")
    for n in range(len(lines)):
        line = lines[n]
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        expect = True  # the next word is in command position
        after_run = False
        start = -1  # where the current word began
        for i in range(len(line) + 1):
            c = line[i] if i < len(line) else " "
            if c not in " \t|&;()`!":
                if start < 0:
                    start = i
                continue
            if start >= 0:
                word = line[start:i]
                start = -1
                if word == "{":
                    # A block opens: `@test "x" { tool; }`, `name() { tool; }`.
                    expect = True
                    after_run = False
                elif expect:
                    if word in _COMMAND_PREFIXES:
                        after_run = word == "run"
                    elif _is_assignment(word) or (after_run and word.startswith("-")):
                        pass
                    else:
                        expect = False
                        after_run = False
                        if (word not in _BUILTINS and word[0] not in "-." and
                            all([ch in _NAME_CHARS for ch in word.elems()])):
                            found.append((word, n, line[i:]))
            if c not in " \t":
                expect = True
                after_run = after_run and c == "!"
    return found

def _following_words(rest):
    """The plain words that start `rest`, up to `_MAX_SUBCOMMAND_WORDS`: the subcommand a
    dispatcher may run. Stops at the end of the command and at the first word that is a flag,
    quoted, or holds an expansion, since its value can't be read statically."""
    for i in range(len(rest)):
        if rest[i] in "|&;()`<>":
            rest = rest[:i]
            break
    words = []
    for word in rest.replace("\t", " ").split(" "):
        if not word:
            continue
        if len(words) == _MAX_SUBCOMMAND_WORDS:
            break
        if word[0] in "-." or not all([ch in _NAME_CHARS for ch in word.elems()]):
            break
        words.append(word)
    return words

# --- Subcommands -------------------------------------------------------------

def _subcommand_patterns(entries):
    """Parses `bash_subcommands` entries `dispatcher=pattern` into
    {dispatcher path: (pattern prefix, pattern suffix)}. Both are workspace-relative paths, and
    the pattern holds one `{}`, which stands for the subcommand's words joined by `-`."""
    patterns = {}
    for entry in _list(entries):
        dispatcher, sep, pattern = entry.partition("=")
        dispatcher = _clean(dispatcher.strip())
        pattern = pattern.strip()
        prefix, brace, suffix = pattern.partition("{}")
        if (not sep or not dispatcher or not brace or "{}" in suffix or "/" in suffix or
            _clean(prefix + "x" + suffix) == None):
            fail("gazelle-bash: bash_subcommands entry must be dispatcher=pattern, with one {} in the pattern's file name, inside the workspace, got: " + entry)
        if dispatcher in patterns:
            fail("gazelle-bash: bash_subcommands names %s twice" % dispatcher)
        clean_prefix = _clean(prefix)
        if prefix.endswith("/"):
            clean_prefix += "/"
        patterns[dispatcher] = (clean_prefix, suffix)
    return patterns

def _pattern_part(ws_path, pattern):
    """The part of `ws_path` that stands for `{}` in `pattern`, or None if it doesn't match."""
    prefix, suffix = pattern
    if len(ws_path) <= len(prefix) + len(suffix) or not ws_path.startswith(prefix) or not ws_path.endswith(suffix):
        return None
    part = ws_path[len(prefix):len(ws_path) - len(suffix)]
    return None if "/" in part else part

def _declared_subcommands(content):
    """The names listed by `# gazelle-bash: subcommands <name>...` lines, or None if there are none."""
    names = None
    for line in content.split("\n"):
        s = line.strip()
        if not s.startswith("#"):
            continue
        gb = _directive(s.lstrip("#").strip(), "gazelle-bash:")
        arg = _directive(gb, "subcommands") if gb != None else None
        if arg == None:
            continue
        if names == None:
            names = []
        names += [w for w in arg.replace("\t", " ").split(" ") if w]
    return names

def _subcommand_symbols(ws_path, content, patterns):
    """Symbols for a file that runs a dispatcher's subcommands: `<dispatcher> <name>` for each
    name its `subcommands` comment lists, else for the name its path gives through the pattern."""
    symbols = []
    for dispatcher, pattern in patterns.items():
        part = _pattern_part(ws_path, pattern)
        if part == None or ws_path == dispatcher:
            continue
        names = _declared_subcommands(content)
        for name in (names if names != None else [part]):
            symbols.append(aspect.Symbol(id = dispatcher + " " + name, provider = _SUBCOMMAND))
    return symbols

def _is_subcommand_dep(imp, pattern):
    """True if a dispatcher's import `imp` is one of its subcommands: a file the pattern matches,
    or a directory tree at or under the pattern's directory."""
    if imp.provider == _TREE:
        pattern_dir = pattern[0].rpartition("/")[0] or "."
        return imp.id == pattern_dir or pattern_dir == "." or imp.id.startswith(pattern_dir + "/")
    return imp.provider == _PROVIDER and _pattern_part(imp.id, pattern) != None

# --- Globs -------------------------------------------------------------------

def _segment_match(pattern, s):
    """Matches one path segment against a pattern with `*` and `?`."""
    states = {0: True}  # how many characters of `s` are consumed
    for i in range(len(pattern)):
        c = pattern[i]
        after = {}
        if c == "*":
            for k in range(min(states.keys()), len(s) + 1):
                after[k] = True
        else:
            for k in states:
                if k < len(s) and (c == "?" or s[k] == c):
                    after[k + 1] = True
        if not after:
            return False
        states = after
    return len(s) in states

def _glob_match(pattern, p):
    """Matches a workspace-relative path against a glob. `**` spans directories."""
    segments = p.split("/")
    states = {0: True}  # how many segments are consumed
    for part in pattern.split("/"):
        if part == "" or part == ".":
            continue
        after = {}
        if part == "**":
            for k in range(min(states.keys()), len(segments) + 1):
                after[k] = True
        else:
            for k in states:
                if k < len(segments) and _segment_match(part, segments[k]):
                    after[k + 1] = True
        if not after:
            return False
        states = after
    return len(segments) in states

# --- Stages ------------------------------------------------------------------

# The convenience symlinks Bazel creates at the workspace root.
_BAZEL_LINKS = ["bazel-*"]

def _prepare(ctx):
    sources = {
        "scripts": aspect.SourceExtensions(".bash", ".sh"),
        "bats": aspect.SourceExtensions(".bats"),
        # Files with no extension; only those whose first line is a sh/bash shebang get a target.
        # Bazel's own `bazel-bin`, `bazel-out`, ... links point at directories, and Orion
        # stops when asked to read one.
        "bare": aspect.SourceGlobs("**", exclude = ["**/*.*"] + _BAZEL_LINKS),
    }
    if _list(ctx.properties["bash_data_files"]):
        # Candidates for a per-file filegroup; `_declare` keeps those the setting names.
        sources["data"] = aspect.SourceGlobs("**", exclude = ["**/BUILD", "**/BUILD.bazel"] + _BAZEL_LINKS)
    return aspect.PrepareResult(
        sources = sources,
        queries = {
            # Whole file: dependency lines are read by `_scan`, which can skip heredocs.
            "content": aspect.RawQuery(),
        },
    )

def _is_shell_shebang(content):
    """True if the file says it is sh or bash: a first line that runs one, directly or through
    `env`, or, with no shebang, a `# shellcheck shell=sh` or `shell=bash` directive in the
    comments before the first command, which ShellCheck reads as the shell of the whole file."""
    lines = content.split("\n")
    first = lines[0].strip()
    if not first.startswith("#!"):
        return _shellcheck_shell(lines) in ("sh", "bash")
    words = [w for w in first[2:].replace("\t", " ").split(" ") if w]
    if not words:
        return False
    interpreter = path.base(words[0])
    if interpreter == "env":
        args = [w for w in words[1:] if not w.startswith("-")]
        interpreter = path.base(args[0]) if args else ""
    return interpreter in ("sh", "bash")

def _shellcheck_shell(lines):
    """The `shell=` of a `# shellcheck` directive in the leading comments, or ""."""
    for line in lines:
        s = line.strip()
        if not s:
            continue
        if not s.startswith("#"):
            return ""
        sc = _directive(s.lstrip("#").strip(), "shellcheck")
        if sc == None:
            continue
        for word in sc.replace("\t", " ").split(" "):
            if word.startswith("shell="):
                return word[len("shell="):]
    return ""

def _stem(base):
    """Target name for a file: its name without extension. A file with no extension gets a
    `_bin` suffix, because a target cannot share a label with its own source file."""
    ext = path.ext(base)
    return base.removesuffix(ext) if ext else base + "_bin"

def _target_names(sources):
    """Maps each path to a target name. When two files in the package would collide, the
    one with an extension folds it in (`foo_sh`)."""
    stems = {}
    for f in sources:
        stem = _stem(path.base(f.path))
        stems[stem] = stems.get(stem, 0) + 1
    names = {}
    for f in sources:
        base = path.base(f.path)
        stem = _stem(base)
        names[f.path] = stem if stems[stem] == 1 or not path.ext(base) else base.replace(".", "_")
    return names

def _join(rel, p):
    return path.join(rel, p) if rel else p

def _symbols(ws_path, tree = True):
    """Symbols for a dependable file: its own path and, with `tree`, every directory above it."""
    symbols = [aspect.Symbol(id = ws_path, provider = _PROVIDER)]
    if not tree:
        return symbols
    parent = ws_path.rpartition("/")[0]
    for _ in range(ws_path.count("/") + 1):
        symbols.append(aspect.Symbol(id = parent or ".", provider = _TREE))
        if not parent:
            break
        parent = parent.rpartition("/")[0]
    return symbols

def _subcommand_imports(ctx, dispatcher, words, registered):
    """The imports of a test that runs `<dispatcher> <words...>`, and the fallbacks they need.

    The test imports `<dispatcher> <all words joined by ->` and the dispatcher's own target. Orion
    looks an import up among the targets' symbols first, so a file that runs that subcommand wins.
    When none does, it takes a symbol this package adds: each subcommand name falls back to the
    one a word shorter (`plugin-add-x`, `plugin-add`, `plugin`), the last to the whole dispatcher,
    and the dispatcher's own target to the whole dispatcher too. Like rules_python, the most
    specific name that exists wins, and a word that names no subcommand still gets a dependency.
    `registered` drops symbols this package already added.
    """
    ids = [dispatcher + " " + "-".join(words[:k]) for k in range(len(words), 0, -1)]
    fallbacks = []
    for i in range(len(ids)):
        if i + 1 < len(ids):
            fallbacks.append((ids[i], _SUBCOMMAND, aspect.Import(id = ids[i + 1], provider = _SUBCOMMAND)))
        else:
            fallbacks.append((ids[i], _SUBCOMMAND, aspect.Import(id = dispatcher, provider = _PROVIDER)))
    fallbacks.append((dispatcher, _DISPATCHER, aspect.Import(id = dispatcher, provider = _PROVIDER)))
    for id, provider, target in fallbacks:
        if (id, provider) not in registered:
            registered[(id, provider)] = True
            ctx.add_symbol(id = id, provider_type = provider, label = target)
    return [(ids[0], _SUBCOMMAND), (dispatcher, _DISPATCHER)]

def _imports(ctx, file, prefixes, roots, path_dirs, is_test, seen = None, own = {}, subcommands = {}, registered = None, explain = {}):
    """Collects `aspect.Import`s for every statically readable dependency of `file`.

    `seen` is shared between calls to drop duplicates across files of one target. `own` holds
    the workspace paths of the files in the target itself; a file path in it is not imported.
    `subcommands` is the parsed `bash_subcommands`, and `registered` the fallback symbols this
    package added for them. A file in `explain` prints why it gets each dependency.
    """
    file_path = _join(ctx.rel, file.path)
    script_dir = file_path.rpartition("/")[0]
    shellcheck_base = script_dir if ctx.properties["bash_shellcheck_relative_to"] == "script" else ""
    is_bats = file.path.endswith(".bats")
    content = file.query_results["content"]
    if seen == None:
        seen = {}
    if registered == None:
        registered = {}
    imports = []
    explaining = file_path in explain

    def add(resolved, optional, why = "", provider = None, line = None):
        """`line` is the 0-based line the dependency comes from, named in Orion's messages."""
        id, tree = resolved
        src = file_path if line == None else "%s:%d" % (file_path, line + 1)
        if provider == None:
            provider = _TREE if tree else _PROVIDER
        if (id, provider) in seen or (provider == _PROVIDER and id in own):
            return
        seen[(id, provider)] = True
        if explaining and why:
            print("gazelle-bash: explain %s: %s" % (file_path, why))
        if provider == _TREE:
            imports.append(aspect.Import(id = id, provider = _TREE, multiple = True, optional = optional, src = src))
        else:
            imports.append(aspect.Import(id = id, provider = provider, optional = optional, src = src))

    def skipped(kind, line, text):
        print("gazelle-bash: %s:%d: skipped %s path that cannot be read statically: %s" % (file_path, line + 1, kind, text))

    # Lines declared by a comment directly above; a dynamic path there is expected.
    scanned = _scan(content)
    covered = {}
    for kind, raw, line in scanned:
        if kind == "dep" or kind == "shellcheck":
            covered[line + 1] = True
    for kind, raw, line in scanned:
        word = raw if kind == "shellcheck" else _first_word(raw)
        if kind == "load":
            if not is_bats:
                continue
            if word and not (word.endswith(".bash") or word.endswith(".sh")):
                word += ".bash"
            resolved = _resolve(word, script_dir, prefixes, roots)
        elif kind == "dep" and word.startswith("//"):
            resolved = _resolve(word[2:], "", [], {}, allow_tree = True)
        elif kind == "dep":
            resolved = _resolve(word, script_dir, prefixes, roots, allow_tree = True)
        elif kind == "shellcheck":
            if word == "/dev/null":
                continue
            if word.startswith("SCRIPTDIR/"):
                resolved = _resolve(word.removeprefix("SCRIPTDIR/"), script_dir, prefixes, roots)
            else:
                resolved = _resolve(word, shellcheck_base, prefixes, roots)
                if resolved == None and word.startswith("../"):
                    # Escapes the workspace root, so it was written relative to the script.
                    resolved = _resolve(word, script_dir, prefixes, roots)
        else:
            resolved = _resolve(word, script_dir, prefixes, roots)
            if resolved != None and "/" not in word and not ctx.has_file(_join(path.dirname(file.path), word)):
                # Bash looks up a bare name on PATH before the current directory.
                if line not in covered:
                    print("gazelle-bash: %s:%d: skipped source of %s: no such file next to the script, so Bash finds it on PATH" % (file_path, line + 1, word))
                continue

        if resolved == None:
            if line not in covered:
                skipped(kind, line, raw.strip())
            continue
        what = "everything under " + resolved[0] if resolved[1] else resolved[0]
        add(resolved, optional = False, why = "line %d: %s %s: %s" % (line + 1, kind, raw.strip(), what), line = line)

    # A test also depends on every `$ROOT_VAR/path` it mentions. These are optional: a test
    # may name a path it creates itself, and the sandbox catches a real one left undeclared.
    if is_test:
        for word, line in _refs(content, roots):
            resolved = _resolve(word, "", [], roots, allow_tree = True)
            if resolved == None:
                if line not in covered:
                    skipped("reference", line, word)
                continue
            why = "line %d: reference %s: %s, if it exists" % (line + 1, word, resolved[0])
            add(resolved, optional = True, why = why, line = line)
            if not resolved[1]:
                add((resolved[0], True), optional = True, line = line)  # the path may be a directory

    # A test also depends on each command it runs by bare name, when a `bash_path_dirs`
    # directory holds a file of that name. Optional: most such words are system commands.
    # A dispatcher that `bash_subcommands` names gets the subcommand the next words run.
    if is_test and path_dirs:
        for word, line, rest in _commands(content):
            for d in path_dirs:
                command = _join(d, word)
                words = _following_words(rest) if command in subcommands else []
                if not words:
                    why = "line %d: command %s: %s, if it exists" % (line + 1, word, command)
                    if command in subcommands:
                        why = "line %d: command %s with no subcommand that can be read: the whole %s" % (line + 1, word, command)
                    add((command, False), optional = True, why = why, line = line)
                    continue
                said = " ".join([word] + words)
                for id, provider in _subcommand_imports(ctx, command, words, registered):
                    if provider == _SUBCOMMAND:
                        shorter = ", then one word shorter, down to one word," if len(words) > 1 else ""
                        why = "line %d: %s: the file that runs subcommand %s of %s%s else the whole %s" % (
                            line + 1,
                            said,
                            "-".join(words),
                            command,
                            shorter or ",",
                            command,
                        )
                    else:
                        why = "line %d: %s: %s without its subcommands, else the whole %s" % (line + 1, said, command, command)
                    add((id, False), optional = True, why = why, provider = provider, line = line)

    return imports

def _data_name(p):
    """Target name for a data file: `docs/a.md` -> `docs_a_md`, `NOTICE` -> `NOTICE_file`."""
    name = p.replace("/", "_").replace(".", "_")
    return name + "_file" if name == p else name

def _declare(ctx):
    scripts = list(ctx.sources.scripts)
    bats = list(ctx.sources.bats)
    bare = [f for f in ctx.sources.bare if _is_shell_shebang(f.query_results["content"])]
    scripts = scripts + bare

    data_files = []
    data_globs = _list(ctx.properties["bash_data_files"])
    if data_globs:
        taken = {f.path: True for f in scripts}
        for f in ctx.sources.data:
            ws_path = _join(ctx.rel, f.path)
            if f.path not in taken and any([_glob_match(g, ws_path) for g in data_globs]):
                data_files.append(f.path)
        data_files = sorted(data_files)

    if not scripts and not bats and not data_files:
        return

    prefixes = _dir_prefixes(ctx.properties["bash_dir_vars"])
    roots = _root_vars(ctx.properties["bash_root_vars"])
    path_dirs = []
    for d in _list(ctx.properties["bash_path_dirs"]):
        cleaned = _clean(d)
        if cleaned == None:
            fail("gazelle-bash: bash_path_dirs entry must be a directory inside the workspace, got: " + d)
        path_dirs.append(cleaned)
    mode = ctx.properties["bash_generation_mode"]
    if mode not in ("file", "package"):
        fail("gazelle-bash: bash_generation_mode must be file or package, got: " + mode)
    # The keyword arguments of `_imports` that come from the package's settings.
    opts = {
        "subcommands": _subcommand_patterns(ctx.properties["bash_subcommands"]),
        "registered": {},
        "explain": {_clean(p): True for p in _list(ctx.properties["bash_explain"])},
    }
    if mode == "package":
        _declare_package(ctx, scripts, bats, data_files, prefixes, roots, path_dirs, opts)
        return

    names = _target_names(scripts + bats)

    used = {name: p for p, name in names.items()}
    dispatchers = {}  # target name of each dispatcher's own target -> its file
    for file in scripts:
        if _join(ctx.rel, file.path) in opts["subcommands"] and not file.path.endswith("_test.sh"):
            name = _stem(path.base(file.path)).removesuffix("_bin") + "_dispatcher"
            if name in used:
                fail("gazelle-bash: %s: %s and %s would both get the target name %s; rename one" % (
                    ctx.rel or ".",
                    used[name],
                    file.path,
                    name,
                ))
            used[name] = file.path
            dispatchers[file.path] = name
    # A script no longer named by `bash_subcommands` loses the target it had as a dispatcher.
    # Orion removes only a rule of a kind this extension registered, and never one marked `# keep`.
    for file in scripts:
        name = _stem(path.base(file.path)).removesuffix("_bin") + "_dispatcher"
        if file.path not in dispatchers and name not in used:
            ctx.targets.remove(name)
    subcommand_owner = {}  # subcommand symbol id -> the file that declares it
    for p in data_files:
        name = _data_name(p)
        if name in used:
            fail("gazelle-bash: %s: %s and %s would both get the target name %s; exclude one from bash_data_files" % (
                ctx.rel or ".",
                used[name],
                p,
                name,
            ))
        used[name] = p
        ctx.targets.add(
            name = name,
            kind = "filegroup",
            attrs = {
                "srcs": [p],
                "visibility": ["//:__subpackages__"],
            },
            symbols = _symbols(_join(ctx.rel, p)),
        )

    for file in scripts:
        kind = "sh_test" if file.path.endswith("_test.sh") else "sh_library"
        ws_path = _join(ctx.rel, file.path)

        data = _imports(ctx, file, prefixes, roots, path_dirs, kind == "sh_test", **opts)
        attrs = {
            "srcs": [file.path],
            "data": data,
        }
        if kind != "sh_test":
            attrs["visibility"] = ["//:__subpackages__"]

        symbols = _symbols(ws_path, tree = kind != "sh_test")
        if kind != "sh_test":
            for s in _subcommand_symbols(ws_path, file.query_results["content"], opts["subcommands"]):
                if s.id in subcommand_owner:
                    fail("gazelle-bash: %s and %s both run subcommand %s; list it in one file's `# gazelle-bash: subcommands` comment" % (
                        _join(ctx.rel, subcommand_owner[s.id]),
                        ws_path,
                        s.id,
                    ))
                subcommand_owner[s.id] = file.path
                symbols.append(s)

        ctx.targets.add(
            name = names[file.path],
            kind = kind,
            attrs = attrs,
            symbols = symbols,
        )

        # The dispatcher on its own: what it sources, without the subcommands it runs. A test
        # that runs one subcommand depends on this and on that subcommand's file.
        if file.path in dispatchers:
            pattern = opts["subcommands"][ws_path]
            ctx.targets.add(
                name = dispatchers[file.path],
                kind = "sh_library",
                attrs = {
                    "srcs": [file.path],
                    "data": [imp for imp in data if not _is_subcommand_dep(imp, pattern)],
                    "visibility": ["//:__subpackages__"],
                },
                symbols = [aspect.Symbol(id = ws_path, provider = _DISPATCHER)],
            )

    for file in bats:
        ctx.targets.add(
            name = names[file.path],
            kind = "bats_test",
            attrs = {
                "srcs": [file.path],
                "data": _imports(ctx, file, prefixes, roots, path_dirs, True, **opts),
            },
        )

def _package_symbols(ctx, files):
    """Symbols for a target that owns several dependable files, without duplicates."""
    seen = {}
    symbols = []
    for p in files:
        for s in _symbols(_join(ctx.rel, p)):
            if (s.id, s.provider) not in seen:
                seen[(s.id, s.provider)] = True
                symbols.append(s)
    return symbols

def _declare_package(ctx, scripts, bats, data_files, prefixes, roots, path_dirs, opts):
    """`bash_generation_mode package`: one `sh_library` for every library and command in the
    package, one filegroup for its `bash_data_files`, and one target per test.

    The library is named after the directory (`root` at the workspace root), the filegroup
    `<name>_files`. A test whose name would clash with either folds its extension in.
    """
    tests = [f for f in scripts if f.path.endswith("_test.sh")] + bats
    libs = sorted([f for f in scripts if not f.path.endswith("_test.sh")], key = lambda f: f.path)

    base = path.base(ctx.rel) if ctx.rel else "root"
    lib_name = base
    files_name = base + "_files"
    taken = {}
    if libs:
        taken[lib_name] = "the package library"
    if data_files:
        taken[files_name] = "the package filegroup"

    names = _target_names(tests)
    for f in tests:
        name = names[f.path]
        if name in taken:
            name = path.base(f.path).replace(".", "_")
        if name in taken:
            fail("gazelle-bash: %s: %s and %s would both get the target name %s; rename the file" % (
                ctx.rel or ".",
                f.path,
                taken[name],
                name,
            ))
        taken[name] = f.path
        names[f.path] = name

    # The targets `file` mode gave these files are stale once the package holds them: remove
    # them, so switching a directory needs no hand cleanup. Orion removes only rules of a kind
    # this extension registered and never a rule marked `# keep`.
    file_names = _target_names(scripts + bats)
    stale = [file_names[f.path] for f in libs]
    stale += [file_names[f.path] for f in tests if file_names[f.path] != names[f.path]]
    stale += [_data_name(p) for p in data_files]
    # A file-mode test that held the library's name (`lib.bats` in `lib/`) is left to the prune
    # step in //:defs.bzl: removing a name here and adding it again in one run deletes it.
    for name in stale:
        if name not in taken:
            ctx.targets.remove(name)

    if data_files:
        ctx.targets.add(
            name = files_name,
            kind = "filegroup",
            attrs = {
                "srcs": data_files,
                "visibility": ["//:__subpackages__"],
            },
            symbols = _package_symbols(ctx, data_files),
        )

    if libs:
        own = {_join(ctx.rel, f.path): True for f in libs}
        seen = {}
        data = []
        for f in libs:
            data += _imports(ctx, f, prefixes, roots, path_dirs, False, seen = seen, own = own, **opts)
        # One target holds every subcommand here, so a test of one of them gains nothing, but
        # the symbols keep it working. A dispatcher gets no target of its own in this mode.
        symbols = _package_symbols(ctx, [f.path for f in libs])
        taken_ids = {}
        for f in libs:
            for s in _subcommand_symbols(_join(ctx.rel, f.path), f.query_results["content"], opts["subcommands"]):
                if s.id not in taken_ids:
                    taken_ids[s.id] = True
                    symbols.append(s)
        ctx.targets.add(
            name = lib_name,
            kind = "sh_library",
            attrs = {
                "srcs": [f.path for f in libs],
                "data": data,
                "visibility": ["//:__subpackages__"],
            },
            symbols = symbols,
        )

    for f in tests:
        attrs = {
            "srcs": [f.path],
            "data": _imports(ctx, f, prefixes, roots, path_dirs, True, **opts),
        }
        if f.path.endswith(".bats"):
            ctx.targets.add(name = names[f.path], kind = "bats_test", attrs = attrs)
        else:
            ctx.targets.add(
                name = names[f.path],
                kind = "sh_test",
                attrs = attrs,
                symbols = _symbols(_join(ctx.rel, f.path), tree = False),
            )

aspect.orion_extension(
    id = "gazelle_bash",
    properties = {
        # How many targets a package's scripts get: "file" (one per file) or "package" (one
        # sh_library for the libraries and commands, one filegroup for bash_data_files; tests
        # keep one target each), eg
        #   # gazelle:bash_generation_mode package
        "bash_generation_mode": aspect.Property(type = "string", default = "file"),
        # Extra variable names that hold "the directory of this script", eg
        #   # gazelle:bash_dir_vars SCRIPT_DIR,HERE
        "bash_dir_vars": aspect.Property(type = "[]string", default = ["SCRIPT_DIR"]),
        # Variables that hold a fixed directory of the repo, as NAME=path from the workspace
        # root (`.` for the root itself), eg
        #   # gazelle:bash_root_vars APP_ROOT=plugin,REPO=.
        "bash_root_vars": aspect.Property(type = "[]string", default = []),
        # Directories that tests put on PATH, from the workspace root. A test that runs a
        # command by bare name depends on the file of that name in one of them, eg
        #   # gazelle:bash_path_dirs plugin/bin,tests/helpers
        "bash_path_dirs": aspect.Property(type = "[]string", default = []),
        # Non-script files that tests may depend on, as globs from the workspace root. Each
        # match gets a filegroup of its own, eg
        #   # gazelle:bash_data_files docs/**,*.md,tests/fixtures/**
        "bash_data_files": aspect.Property(type = "[]string", default = []),
        # Dispatchers whose subcommands are files of their own, as dispatcher=pattern from the
        # workspace root. `{}` stands for the subcommand, its words joined by `-`. A test that
        # runs `tool sync` depends on the dispatcher without its subcommands and on the file
        # that runs `sync`, eg
        #   # gazelle:bash_subcommands bin/tool=libexec/tool-{},bin/asdf=lib/commands/command-{}.bash
        # A file the pattern matches can name the subcommands it runs instead, eg
        #   # gazelle-bash: subcommands next start
        "bash_subcommands": aspect.Property(type = "[]string", default = []),
        # Files, from the workspace root, that print why they get each dependency, eg
        #   # gazelle:bash_explain tests/sync.bats
        "bash_explain": aspect.Property(type = "[]string", default = []),
        # What a `# shellcheck source=path` is relative to: "workspace" (ShellCheck run from
        # the repo root, its default) or "script". `source=SCRIPTDIR/...` is always the script's.
        "bash_shellcheck_relative_to": aspect.Property(type = "string", default = "workspace"),
        # bats tags that become Bazel `tags` on a bats test, each as NAME or NAME=tag+tag, eg
        #   # gazelle:bats_tags structure=manual+structure,requires-network
        # Declared here so Gazelle knows the directive. It is read by the tags step of
        # gazelle_bash() in //:defs.bzl (wrapper/bats_tags.sh), not by this file: Gazelle either
        # replaces a whole `tags` list or leaves it alone, and can't own some of its values.
        "bats_tags": aspect.Property(type = "[]string", default = []),
    },
    prepare = _prepare,
    declare = _declare,
)
