"""Gazelle (Aspect Orion) extension for Bash scripts and bats tests.

Started from aspect-starters/shell `.aspect/gazelle/shell.axl` (Apache-2.0), then extended:

  * one target per script, so Bazel can skip tests a change cannot reach;
  * `source path` / `. path` lines become `deps`;
  * `*.bats` files become `bats_test` targets, and their `load name` lines become `data`;
  * `# gazelle-bash: dep <path>` declares a dependency that cannot be read statically.

Generation rules:

  | Input                                 | Output                 |
  | ------------------------------------- | ---------------------- |
  | `*_test.sh`                           | `sh_test`              |
  | `*.sh` / `*.bash` with a `#!...sh`    | `sh_binary`            |
  | `*.sh` / `*.bash` without a shebang   | `sh_library`           |
  | `*.bats`                              | `bats_test`            |

Every script publishes its workspace-relative path as a `shell` symbol, so a captured
path resolves to the label of whichever target owns that script, in any package.
A literal path that matches no script fails generation. A path still containing `$`
after normalisation is reported and skipped; use the comment convention for it.
"""

_PROVIDER = "shell"

aspect.gazelle_rule_kind("sh_binary", {
    "From": "@rules_shell//shell:sh_binary.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["deps"],
})
aspect.gazelle_rule_kind("sh_library", {
    "From": "@rules_shell//shell:sh_library.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["deps"],
})
aspect.gazelle_rule_kind("sh_test", {
    "From": "@rules_shell//shell:sh_test.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["deps"],
})
aspect.gazelle_rule_kind("bats_test", {
    "From": "@bazel_lib//lib:bats.bzl",
    "MergeableAttrs": ["srcs"],
    "ResolveAttrs": ["data"],
})

# --- Path extraction ---------------------------------------------------------

def _first_word(s):
    """Returns the first shell word of `s` with quoting removed.

    Quotes nested inside `$(...)` / `${...}` are dropped too, so
    `"$(dirname "${BASH_SOURCE[0]}")/lib.sh"` becomes `$(dirname ${BASH_SOURCE[0]})/lib.sh`.
    """
    out = []
    quote = ""  # "", "'" or "\""
    depth = 0  # nesting of $( ) and ${ }
    escaped = False
    prev = ""
    for c in s.elems():
        if escaped:
            out.append(c)
            escaped = False
            prev = c
            continue
        if quote == "'":
            if c == "'":
                quote = ""
            else:
                out.append(c)
            prev = c
            continue
        if c == "\\":
            escaped = True
            prev = c
            continue
        if c == "'" or c == "\"":
            if depth == 0:
                if quote == "":
                    quote = c
                elif quote == c:
                    quote = ""
            prev = c
            continue
        if depth == 0 and quote == "":
            if c in " \t;&|<>)":
                break
            if c == "#" and not out:
                break
        if (c == "(" or c == "{") and (prev == "$" or depth > 0):
            depth += 1
        elif (c == ")" or c == "}") and depth > 0:
            depth -= 1
        out.append(c)
        prev = c
    return "".join(out)

def _dir_prefixes(dir_vars):
    """Spellings of "the directory of this script", after quote removal."""
    prefixes = [
        "$(dirname ${BASH_SOURCE[0]})/",
        "$(dirname ${BASH_SOURCE})/",
        "$(dirname $BASH_SOURCE)/",
        "$(dirname -- ${BASH_SOURCE[0]})/",
        "$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)/",
        "$(cd -- $(dirname -- ${BASH_SOURCE[0]}) && pwd)/",
        "${BASH_SOURCE%/*}/",
        "${BASH_SOURCE[0]%/*}/",
        "$(dirname $0)/",
        "$(dirname ${0})/",
        "${0%/*}/",
        "$BATS_TEST_DIRNAME/",
        "${BATS_TEST_DIRNAME}/",
    ]
    for v in dir_vars:
        prefixes.append("$" + v + "/")
        prefixes.append("${" + v + "}/")
    return prefixes

def _clean(p):
    """Collapses `.` and `..` segments. Returns None if the path escapes the workspace."""
    parts = []
    for seg in p.split("/"):
        if seg == "" or seg == ".":
            continue
        if seg == "..":
            if not parts:
                return None
            parts.pop()
        else:
            parts.append(seg)
    return "/".join(parts)

def _normalise(word, script_dir, prefixes, allow_root = False):
    """Turns a captured path into a workspace-relative path, or None if it cannot be read statically."""
    if not word:
        return None
    if allow_root and word.startswith("//"):
        return _clean(word[2:])
    for prefix in prefixes:
        if word.startswith(prefix):
            word = word[len(prefix):]
            break
    if "$" in word or "`" in word or "*" in word or "?" in word or word.startswith("/") or word.startswith("~"):
        return None
    return _clean(path.join(script_dir, word) if script_dir else word)

# --- Stages ------------------------------------------------------------------

def _prepare(_):
    return aspect.PrepareResult(
        sources = {
            "scripts": aspect.SourceExtensions(".bash", ".sh"),
            "bats": aspect.SourceExtensions(".bats"),
        },
        queries = {
            "shebang": aspect.RegexQuery(
                expression = "^#!.*sh",
            ),
            # `source path` or `. path`, anchored to line start to avoid most strings and heredocs.
            "source": aspect.RegexQuery(
                expression = "(?m)^[ \\t]*(?:source|\\.)[ \\t]+(?P<arg>[^\\n]+)",
                content_filter = "(?m)^[ \\t]*(?:source|\\.)[ \\t]",
            ),
            "load": aspect.RegexQuery(
                filter = "*.bats",
                expression = "(?m)^[ \\t]*load[ \\t]+(?P<arg>[^\\n]+)",
            ),
            "comment_dep": aspect.RegexQuery(
                expression = "(?m)^[ \\t]*#[ \\t]*gazelle-bash:[ \\t]*dep[ \\t]+(?P<arg>[^\\n]+)",
                content_filter = "gazelle-bash:",
            ),
        },
    )

def _target_names(sources):
    """Maps each path to a target name: its basename without extension, or with the
    extension folded in (`foo_sh`) when two files in the package would collide."""
    stems = {}
    for f in sources:
        base = path.base(f.path)
        stem = base.removesuffix(path.ext(base))
        stems[stem] = stems.get(stem, 0) + 1
    names = {}
    for f in sources:
        base = path.base(f.path)
        stem = base.removesuffix(path.ext(base))
        names[f.path] = stem if stems[stem] == 1 else base.replace(".", "_")
    return names

def _imports(ctx, file, prefixes):
    """Collects `aspect.Import`s for every statically readable dependency of `file`."""
    script_dir = path.join(ctx.rel, path.dirname(file.path)) if ctx.rel else path.dirname(file.path)
    is_bats = file.path.endswith(".bats")
    seen = {}
    imports = []

    def add(id, kind, raw):
        if id == None:
            print("gazelle-bash: %s: skipped dynamic %s path: %s" % (path.join(ctx.rel, file.path), kind, raw.strip()))
            return
        if id in seen:
            return
        seen[id] = True
        imports.append(aspect.Import(id = id, provider = _PROVIDER, src = file.path))

    for m in file.query_results["source"]:
        raw = m.captures["arg"]
        add(_normalise(_first_word(raw), script_dir, prefixes), "source", raw)

    if is_bats:
        for m in file.query_results["load"]:
            raw = m.captures["arg"]
            word = _first_word(raw)
            if word and not (word.endswith(".bash") or word.endswith(".sh")):
                word += ".bash"
            add(_normalise(word, script_dir, prefixes), "load", raw)

    for m in file.query_results["comment_dep"]:
        raw = m.captures["arg"]
        add(_normalise(_first_word(raw), script_dir, prefixes, allow_root = True), "comment", raw)

    return imports

def _declare(ctx):
    scripts = list(ctx.sources.scripts)
    bats = list(ctx.sources.bats)
    if not scripts and not bats:
        return

    prefixes = _dir_prefixes(ctx.properties["bash_dir_vars"])
    names = _target_names(scripts + bats)

    for file in scripts:
        if file.path.endswith("_test.sh"):
            kind = "sh_test"
        elif len(file.query_results["shebang"]) > 0:
            kind = "sh_binary"
        else:
            kind = "sh_library"

        attrs = {
            "srcs": [file.path],
            "deps": _imports(ctx, file, prefixes),
        }
        if kind == "sh_library":
            attrs["visibility"] = ["//:__subpackages__"]

        ctx.targets.add(
            name = names[file.path],
            kind = kind,
            attrs = attrs,
            symbols = [aspect.Symbol(
                id = path.join(ctx.rel, file.path) if ctx.rel else file.path,
                provider = _PROVIDER,
            )],
        )

    for file in bats:
        ctx.targets.add(
            name = names[file.path],
            kind = "bats_test",
            attrs = {
                "srcs": [file.path],
                "data": _imports(ctx, file, prefixes),
            },
        )

aspect.orion_extension(
    id = "gazelle_bash",
    properties = {
        # Extra variable names that hold "the directory of this script", eg
        #   # gazelle:bash_dir_vars SCRIPT_DIR,HERE
        "bash_dir_vars": aspect.Property(type = "[]string", default = ["SCRIPT_DIR"]),
    },
    prepare = _prepare,
    declare = _declare,
)
