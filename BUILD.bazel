load("@aspect_gazelle_prebuilt//:def.bzl", "aspect_gazelle")

# Golden cases are run by //tests/golden:golden_test, not generated in place.
# gazelle:exclude tests/golden

exports_files(
    ["shell.axl"],
    visibility = ["//visibility:public"],
)

# Regenerates the BUILD files under tests/ from the fixtures.
#   bazel run //:gazelle        - update BUILD files
#   bazel run //:gazelle.check  - fail if any BUILD file is stale (CI)
aspect_gazelle(
    name = "gazelle",
    extensions = [":shell.axl"],
    languages = [],
    visibility = ["//tests:__subpackages__"],
    with_check = True,
)
