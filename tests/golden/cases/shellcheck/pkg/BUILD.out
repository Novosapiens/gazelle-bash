load("@rules_shell//shell:sh_library.bzl", "sh_library")

sh_library(
    name = "b",
    srcs = ["b.sh"],
    visibility = ["//:__subpackages__"],
)

sh_library(
    name = "c",
    srcs = ["c.sh"],
    visibility = ["//:__subpackages__"],
)

sh_library(
    name = "quoted",
    srcs = ["quoted.sh"],
    data = [
        "//lib:a",
        "//lib:my lib",
    ],
    visibility = ["//:__subpackages__"],
)

sh_library(
    name = "user",
    srcs = ["user.sh"],
    data = [
        ":b",
        "//lib:a",
    ],
    visibility = ["//:__subpackages__"],
)
