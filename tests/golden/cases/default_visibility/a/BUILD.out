load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

filegroup(
    name = "notes_txt",
    srcs = ["notes.txt"],
    visibility = [
        "//ci:__subpackages__",
        "//tests:__pkg__",
    ],
)

sh_library(
    name = "x",
    srcs = ["x.sh"],
    visibility = [
        "//ci:__subpackages__",
        "//tests:__pkg__",
    ],
)

sh_test(
    name = "x_test",
    srcs = ["x_test.sh"],
    data = [":x"],
)
