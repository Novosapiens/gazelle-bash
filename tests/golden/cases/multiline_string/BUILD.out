load("@rules_shell//shell:sh_library.bzl", "sh_library")

sh_library(
    name = "lib",
    srcs = ["lib.sh"],
    visibility = ["//:__subpackages__"],
)

sh_library(
    name = "lost_track",
    srcs = ["lost_track.sh"],
    data = [":lib"],
    visibility = ["//:__subpackages__"],
)

sh_library(
    name = "strings",
    srcs = ["strings.sh"],
    data = [":lib"],
    visibility = ["//:__subpackages__"],
)
