load("@bazel_lib//lib:bats.bzl", "bats_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")

sh_library(
    name = "a",
    srcs = ["a.sh"],
    visibility = ["//:__subpackages__"],
)

# keep
sh_library(
    name = "b",
    srcs = ["b.sh"],
    visibility = ["//:__subpackages__"],
)

sh_binary(
    name = "c",
    srcs = ["c.sh"],
)

bats_test(
    name = "lib",
    srcs = ["lib.bats"],
    data = [":a"],
)
